From 95d9d4af49e878cf78f49465b160cd46e7073532 Mon Sep 17 00:00:00 2001
From: zingzy <zingzy@users.noreply.github.com>
Date: Mon, 26 Oct 2026 23:55:42 +0000
Subject: [PATCH 3/6] gpui: record key contexts, focus handles and text inputs
 for driver tools

A text field and a button both listen for the mouse, so the frame record
could not tell them apart. Nodes now carry their key context and focus
handle, the frame lists the focus handles that registered an input
handler, and click listeners are kept apart from raw mouse listeners.
---
 crates/gpui/src/elements/div.rs  | 24 +++++++++++++++------
 crates/gpui/src/window.rs        | 37 ++++++++++++++++++++++++++++++--
 crates/gpui/src/window/driver.rs | 14 ++++++++++--
 3 files changed, 65 insertions(+), 10 deletions(-)

diff --git a/crates/gpui/src/elements/div.rs b/crates/gpui/src/elements/div.rs
index 75972c1..a808a65 100644
--- a/crates/gpui/src/elements/div.rs
+++ b/crates/gpui/src/elements/div.rs
@@ -2363,11 +2363,15 @@ impl Interactivity {
         self.content_size = content_size;
 
         if window.driver_enabled() {
-            window.driver_set_flags(crate::DriverFlags {
-                click: !self.click_listeners.is_empty()
-                    || !self.aux_click_listeners.is_empty()
-                    || !self.mouse_down_listeners.is_empty()
-                    || !self.mouse_up_listeners.is_empty(),
+            let flags = crate::DriverFlags {
+                click: !self.click_listeners.is_empty() || !self.aux_click_listeners.is_empty(),
+                mouse: !self.mouse_down_listeners.is_empty()
+                    || !self.mouse_up_listeners.is_empty()
+                    || !self.mouse_move_listeners.is_empty()
+                    || !self.mouse_pressure_listeners.is_empty(),
+                keys: !self.key_down_listeners.is_empty()
+                    || !self.key_up_listeners.is_empty()
+                    || !self.action_listeners.is_empty(),
                 hover: self.hover_style.is_some()
                     || self.group_hover_style.is_some()
                     || self.hover_listener.is_some(),
@@ -2380,7 +2384,15 @@ impl Interactivity {
                 drag: self.drag_listener.is_some(),
                 drop: !self.drop_listeners.is_empty(),
                 tooltip: self.tooltip_builder.is_some(),
-            });
+                blocks: self.hitbox_behavior != HitboxBehavior::Normal,
+            };
+            let key_context = self
+                .key_context
+                .as_ref()
+                .and_then(|context| context.primary())
+                .map(|entry| entry.key.clone());
+            let focus = self.tracked_focus_handle.as_ref().map(|handle| handle.id);
+            window.driver_note_interactivity(flags, key_context, focus);
         }
 
         #[cfg(any(feature = "inspector", debug_assertions))]
